# --- Pflicht ---------------------------------------------------------------
# Datenbank-Passwort (beliebig, lang)
POSTGRES_PASSWORD=subbapassword
# Schlüssel zum Verschlüsseln gespeicherter IMAP/SMTP/DAV-Passwörter.
# Erzeugen mit:  openssl rand -hex 32   — NICHT mehr ändern, sobald Konten angelegt sind!
SECRET_KEY=1200482a4e9a0a60957c266b51f42eeb3deca21bef814fa8fdcf1cd09370756c

# --- Erster Administrator ---------------------------------------------------
ADMIN_USERNAME=admin
# Leer lassen = zufälliges Passwort wird beim ersten Start ins Log geschrieben
ADMIN_PASSWORD=admin

# --- Netzwerk ----------------------------------------------------------------
# Auf welcher Adresse/Port die App lauscht (127.0.0.1 = nur lokal / hinter Proxy)
HTTP_BIND=0.0.0.0
HTTP_PORT=8585
# Hinter HTTPS-Proxy (z. B. Caddy-Profil "tls"): true setzen
COOKIE_SECURE=true
TRUST_PROXY=true
# Domain für das optionale Caddy-Profil (docker compose --profile tls up -d)
DOMAIN=webmail.mfrlab.org

# --- Verhalten ---------------------------------------------------------------
# Selbstregistrierung neuer Benutzer erlauben
ALLOW_REGISTRATION=false
# Wie viele der neuesten Nachrichten pro Ordner beim ersten Sync geladen werden
SYNC_INITIAL_MESSAGES=1000
# Abfrageintervall für Ordner ohne IMAP-IDLE (INBOX wird per IDLE gepusht)
POLL_INTERVAL_SECONDS=120
TZ=Europe/Zurich

AUTH_MODE=imap
AUTH_IMAP_HOST=192.168.1.30
AUTH_SMTP_HOST=            # leer = gleicher Server
AUTH_SMTP_PORT=25
AUTH_DEFAULT_DOMAIN=       # optional: "marcus" statt "marcus@domain.ch"
AUTH_ADMINS=admin
AUTH_DAV_URL=https://mail.floeser.net/SOGo/dav

AUTH_IMAP_PORT=143
AUTH_IMAP_SECURITY=           # leer lassen = STARTTLS; „none“ nur ohne STARTTLS im internen Netz
AUTH_ALLOW_INSECURE_TLS=true  # nur falls der Mailserver ein selbstsigniertes Zertifikat hat


PUBLIC_URL=https://mail.mfrlab.org
LDAP_URL=ldap://192.168.1.23:389
LDAP_STARTTLS=false
LDAP_TLS_INSECURE=false
LDAP_BIND_DN=cn=admin,dc=mfrlab,dc=org        # Dienstkonto
LDAP_BIND_PASSWORD=admin
LDAP_BASE_DN=ou=users,dc=mfrlab,dc=org
LDAP_USER_FILTER=(|(uid={user})(mail={user}))
LDAP_RECOVERY_ATTRS=mailAlternateAddress
LDAP_PASSWORD_METHOD=exop                          # oder ssha / plain / ad
SYSTEM_SMTP_HOST=… 
SYSTEM_SMTP_PORT=587 
SYSTEM_MAIL_FROM=Webmail <noreply@…>
