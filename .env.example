# --- Pflicht ---------------------------------------------------------------
# Datenbank-Passwort (beliebig, lang)
POSTGRES_PASSWORD=bitte-aendern
# Schlüssel zum Verschlüsseln gespeicherter IMAP/SMTP/DAV-Passwörter.
# Erzeugen mit:  openssl rand -hex 32   — NICHT mehr ändern, sobald Konten angelegt sind!
SECRET_KEY=bitte-aendern

# --- Anmeldung -----------------------------------------------------------
# local = eigene Webmail-Passwörter
# imap  = Anmeldung direkt mit den Zugangsdaten des IMAP-Servers.
#         Beim ersten Login wird der Benutzer samt Postfach automatisch angelegt.
AUTH_MODE=imap
# Nur für die Ersteinrichtung: daraus entsteht beim ersten Start die Standard-Domain „*“.
# Danach werden Mailserver als Admin unter „Benutzer → Domains & Mailserver“ gepflegt.
AUTH_IMAP_HOST=mail.example.com
AUTH_IMAP_PORT=993
# Verschlüsselung: leer = automatisch nach Port (993 → SSL/TLS, 143 → STARTTLS)
# none = unverschlüsselt (nur im internen Netz, z. B. Port 143 ohne STARTTLS)
AUTH_IMAP_SECURITY=
# SMTP für das automatisch angelegte Postfach (Host leer = wie IMAP)
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
# leer = automatisch (465 → SSL/TLS, 587/25 → STARTTLS) | ssl | starttls | none
AUTH_SMTP_SECURITY=
# Selbstsigniertes Zertifikat am eigenen Mailserver akzeptieren
AUTH_ALLOW_INSECURE_TLS=false
# Optional: "marcus" wird zu "marcus@example.com" ergänzt
AUTH_DEFAULT_DOMAIN=
# Logins mit Admin-Rechten (kommagetrennt, so wie man sich anmeldet)
AUTH_ADMINS=
# Postfach beim ersten Login automatisch als Konto einrichten
AUTH_CREATE_ACCOUNT=true
# Optional: CalDAV/CardDAV-Server, der beim Login mit denselben Zugangsdaten
# eingebunden wird (z. B. https://cloud.example.com/remote.php/dav oder https://mail.example.com/SOGo/dav)
AUTH_DAV_URL=
AUTH_DAV_NAME=Kalender & Kontakte

# --- Passwort ändern / vergessen (LDAP) --------------------------------------
# Öffentliche Adresse der Webmail – nötig für den Link in der "Passwort vergessen"-Mail
PUBLIC_URL=https://mail.example.com
PASSWORD_MIN_LENGTH=8
# Gültigkeit des Zurücksetzen-Links in Minuten
PASSWORD_RESET_MINUTES=30
# Hinweis bei "Passwort vergessen", falls kein automatischer Ablauf eingerichtet ist
PASSWORD_HELP_TEXT=

# LDAP-Server, in dem die Passwörter liegen.
#   ldaps://host:636                       – verschlüsselt (TLS)
#   ldap://host:389 + LDAP_STARTTLS=true   – verschlüsselt (StartTLS)
#   ldap://host:389 + LDAP_STARTTLS=false  – unverschlüsselt, nur in einem abgeschotteten Docker-Netz
#                                            (siehe docker-compose.override.yml.example)
LDAP_URL=ldaps://ldap.example.com
LDAP_STARTTLS=false
LDAP_TLS_INSECURE=false
# Dienstkonto zum Suchen der Benutzer und für "Passwort vergessen" (braucht Schreibrecht auf userPassword)
LDAP_BIND_DN=cn=webmail,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=ou=people,dc=example,dc=com
# Platzhalter: {user} = Login wie eingegeben (inkl. Domain-Ergänzung), {localpart} = Teil vor dem @, {domain}
LDAP_USER_FILTER=(|(uid={user})(mail={user}))
# Alternativ statt Suche: fester DN, z. B. uid={localpart},ou=people,dc=example,dc=com
LDAP_USER_DN_TEMPLATE=
LDAP_MAIL_ATTR=mail
# Attribut(e) mit der privaten Ersatzadresse für den Zurücksetzen-Link (kommagetrennt)
LDAP_RECOVERY_ATTRS=mailAlternateAddress
# Ohne Ersatzadresse den Link an die normale Mailadresse senden (nur sinnvoll, wenn das Postfach z. B. am Handy noch angemeldet ist)
LDAP_RECOVERY_FALLBACK_PRIMARY=false
# exop (RFC 3062, OpenLDAP/389-DS/FreeIPA – Standard) | ssha | plain | ad (Active Directory, nur LDAPS)
LDAP_PASSWORD_METHOD=exop

# Absender für Systemmails (Passwort vergessen)
SYSTEM_SMTP_HOST=mail.example.com
SYSTEM_SMTP_PORT=587
# leer = automatisch nach Port | ssl | starttls | none
SYSTEM_SMTP_SECURITY=
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_TLS_INSECURE=false
SYSTEM_MAIL_FROM=Webmail <noreply@example.com>

# --- Erster Administrator ---------------------------------------------------
ADMIN_USERNAME=admin
# Lokaler Notfall-Admin. Bei AUTH_MODE=imap nur angelegt, wenn ein Passwort gesetzt ist;
# bei AUTH_MODE=local: leer lassen = zufälliges Passwort im Log
ADMIN_PASSWORD=

# --- Netzwerk ----------------------------------------------------------------
# Auf welcher Adresse/Port die App lauscht (127.0.0.1 = nur lokal / hinter Proxy)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Hinter dem Nginx-Reverse-Proxy mit HTTPS: beide auf true lassen
COOKIE_SECURE=true
TRUST_PROXY=true
# Anmeldung mit „Angemeldet bleiben“: gültig für so viele Tage seit der letzten Nutzung
SESSION_DAYS=30
# Ohne „Angemeldet bleiben“: endet beim Schliessen des Browsers bzw. nach so vielen Stunden Inaktivität
SESSION_IDLE_HOURS=12

# --- Verhalten ---------------------------------------------------------------
# Selbstregistrierung neuer Benutzer erlauben
ALLOW_REGISTRATION=false
# Wie viele der neuesten Nachrichten pro Ordner beim ersten Sync geladen werden
SYNC_INITIAL_MESSAGES=1000
# Abfrageintervall für Ordner ohne IMAP-IDLE (INBOX wird per IDLE gepusht)
POLL_INTERVAL_SECONDS=120
TZ=Europe/Zurich
